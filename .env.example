# ============================================
# SUPABASE (Database + Auth)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ============================================
# STRIPE (Payments)
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# BLOCKCHAIN (Ethereum, Polygon, SKALE)
# ============================================
# Frontend (RPC URLs)
NEXT_PUBLIC_INFURA_KEY=your-infura-key
NEXT_PUBLIC_ALCHEMY_KEY=your-alchemy-key

# Smart Contract Addresses (update after deployment)
NEXT_PUBLIC_SHOPPING_TOKEN_ADDRESS=0x...
NEXT_PUBLIC_SHOPPING_DAO_ADDRESS=0x...

# Chainlink Price Feed (for USD conversion)
NEXT_PUBLIC_CHAINLINK_ETH_USD_FEED=0x...

# ============================================
# SMART CONTRACT DEPLOYMENT
# ============================================
# Hardhat / Deployment Keys
PRIVATE_KEY=your-private-key
ETHERSCAN_API_KEY=your-etherscan-key
POLYGONSCAN_API_KEY=your-polygonscan-key

# RPC URLs for deployment
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/...
POLYGON_RPC_URL=https://polygon-rpc.com
SKALE_RPC_URL=https://base-sepolia-testnet.skalenodes.com/...

# ============================================
# SOCKET.IO (Real-time Updates)
# ============================================
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
SOCKET_AUTH_TOKEN=your-socket-auth-token

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=SoundMoney Shopping

# ============================================
# STORAGE (Images)
# ============================================
# Using Supabase Storage (built-in)
SUPABASE_STORAGE_BUCKET=shopping-images

# Or AWS S3 (optional)
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_S3_BUCKET=shopping-images

# ============================================
# SEARCH (Algolia - optional)
# ============================================
# NEXT_PUBLIC_ALGOLIA_APP_ID=xxx
# ALGOLIA_ADMIN_KEY=xxx

# ============================================
# EMAIL (SendGrid - optional)
# ============================================
# SENDGRID_API_KEY=xxx

# ============================================
# LOGGING & MONITORING
# ============================================
# LOG_LEVEL=info
